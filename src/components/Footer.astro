---
import site from '../data/site.json';
const { author } = site;
const year = new Date().getFullYear();

const links = [
  {
    label: 'Email',
    value: author.email,
    href: `mailto:${author.email}`,
    icon: 'M22 6c0-1.1-.9-2-2-2H4a2 2 0 0 0-2 2m20 0v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6m20 0-10 7L2 6'
  },
  {
    label: 'GitHub',
    value: 'Raysh454',
    href: author.github,
    icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22'
  },
  {
    label: 'LinkedIn',
    value: 'shehryar-baloch',
    href: author.linkedin,
    icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z'
  },
  {
    label: 'HackTheBox',
    value: 'Raysh454',
    href: author.hackthebox,
    icon: 'M12 2 3 7v10l9 5 9-5V7zM12 2v20M3 7l9 5 9-5'
  }
];
---

<footer class="border-t border-white/5 mt-24">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr] md:gap-16">

      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Let's build something.</h2>
        <p class="mt-3 text-sm text-zinc-400 leading-relaxed max-w-sm">
          Open to software engineering and security roles. The fastest way to reach me is email —
          I read everything.
        </p>
        <a
          href={`mailto:${author.email}`}
          class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-accent text-black font-semibold text-sm hover:bg-accent-hover transition-colors"
        >
          {author.email}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

      <div>
        <h3 class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-4">Elsewhere</h3>
        <ul class="space-y-1">
          {links.map(link => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                class="group flex items-center justify-between gap-4 py-2 px-3 -mx-3 rounded-lg text-sm text-zinc-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <span class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-zinc-600 group-hover:text-accent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={link.icon}></path>
                  </svg>
                  {link.label}
                </span>
                <span class="font-mono text-xs text-zinc-600 group-hover:text-accent transition-colors truncate max-w-[45%]">
                  {link.value}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-zinc-600">
      <span>© {year} {author.name}</span>
      <span>{author.location}</span>
    </div>
  </div>
</footer>
