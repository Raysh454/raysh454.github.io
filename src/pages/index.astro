---
import Layout from '../layouts/Layout.astro';
import { getStats, getFeaturedProjects, getWriteups } from '../utils/content.js';

const stats = getStats();
const featuredProjects = getFeaturedProjects().slice(0, 4);
const latestWriteups = getWriteups().slice(0, 5);

const difficultyOrder = ['Easy', 'Medium', 'Hard', 'Insane'];
const difficultyTotal = difficultyOrder.reduce((sum, key) => sum + stats.byDifficulty[key], 0) || 1;
const difficultyBar = difficultyOrder.map(key => ({
  key,
  count: stats.byDifficulty[key],
  percent: (stats.byDifficulty[key] / difficultyTotal) * 100
}));

const difficultyColor = {
  Easy: 'bg-accent',
  Medium: 'bg-amber-400',
  Hard: 'bg-rose-500',
  Insane: 'bg-violet-500'
};
---

<Layout>
  <div class="max-w-6xl mx-auto px-4">

    {/* ============ HERO ============ */}
    <section class="py-10 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

        {/* Left column */}
        <div class="lg:col-span-7 flex flex-col items-start text-left">

          <div data-reveal class="space-y-3">
            <h1 class="text-5xl sm:text-6xl md:text-7xl font-black text-white tracking-tighter leading-[0.95]">
              Shehryar Baloch<span class="text-accent">.</span>
            </h1>
            <p class="text-xl md:text-2xl font-semibold text-zinc-200">
              Software Engineer <span class="text-zinc-600">&amp;</span> Security Researcher
            </p>
          </div>

          <p data-reveal data-reveal-delay="2" class="mt-6 text-base md:text-lg text-zinc-400 leading-relaxed max-w-xl">
            I build secure backends and low-level systems tooling — and I break them too.
            {stats.writeups} published attack-chain writeups, {stats.projects} shipped projects,
            and a national hackathon win for an AI agent that designs levels to beat you.
          </p>

          {/* CTAs */}
          <div data-reveal data-reveal-delay="3" class="flex flex-wrap gap-3 pt-8">
            <a href="/projects" class="btn-primary">
              View Projects
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
            <a href="/writeups" class="btn-secondary">Read Writeups</a>
            <a href="/about" class="btn-ghost">About me</a>
          </div>

          {/* Quick facts */}
          <div data-reveal data-reveal-delay="4" class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-10 pt-6 border-t border-white/5 w-full max-w-xl text-zinc-500 font-mono text-xs">
            <span class="flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Karachi, Pakistan
            </span>
            <span class="text-zinc-700" aria-hidden="true">•</span>
            <span>B.S. Computer Science — 3.68 GPA</span>
            <span class="text-zinc-700" aria-hidden="true">•</span>
            <span class="flex items-center gap-1.5">
              <span class="online-dot"></span>
              Open to opportunities
            </span>
          </div>

        </div>

        {/* Right column — real telemetry */}
        <div class="lg:col-span-5 w-full" data-reveal data-reveal-delay="2">
          <div class="cyber-card p-6 rounded-3xl w-full max-w-md mx-auto lg:ml-auto">

            <div class="flex items-center justify-between border-b border-white/5 pb-4 mb-6">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-accent/80"></span>
              </div>
              <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">Security Research</div>
            </div>

            {/* Headline metrics */}
            <div class="grid grid-cols-3 gap-3 mb-7">
              <div class="card-inner">
                <span class="stat-number" data-count-to={stats.writeups}>{stats.writeups}</span>
                <span class="stat-label">Writeups</span>
              </div>
              <div class="card-inner">
                <span class="stat-number" data-count-to={stats.activeDirectory}>{stats.activeDirectory}</span>
                <span class="stat-label">AD Chains</span>
              </div>
              <div class="card-inner">
                <span class="stat-number" data-count-to={stats.hardOrAbove}>{stats.hardOrAbove}</span>
                <span class="stat-label">Hard+</span>
              </div>
            </div>

            {/* Difficulty distribution */}
            <div class="mb-6">
              <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-2.5">Difficulty distribution</div>
              <div class="flex h-2 rounded-full overflow-hidden bg-white/5 gap-0.5">
                {difficultyBar.map(d => d.count > 0 && (
                  <div
                    class={`${difficultyColor[d.key]} opacity-80`}
                    style={`width:${d.percent}%`}
                    title={`${d.key}: ${d.count}`}
                  ></div>
                ))}
              </div>
              <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3">
                {difficultyBar.map(d => (
                  <span class="flex items-center gap-1.5 text-[10px] font-mono text-zinc-500">
                    <span class={`w-1.5 h-1.5 rounded-full ${difficultyColor[d.key]}`}></span>
                    {d.key} <span class="text-zinc-400 font-semibold">{d.count}</span>
                  </span>
                ))}
              </div>
            </div>

            {/* OS split */}
            <div class="mb-6 pt-5 border-t border-white/5">
              <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-2.5">Target platforms</div>
              <div class="flex items-center gap-4">
                <span class="flex items-center gap-2 text-xs font-mono text-zinc-300">
                  <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.45H0V3.449zM0 12.45h9.75v9.45L0 20.551v-8.1zM10.8 1.95L24 0v11.55H10.8V1.95zM10.8 12.45H24v11.55l-13.2-1.95v-9.6z"/></svg>
                  Windows <span class="text-white font-semibold">{stats.byOs.Windows}</span>
                </span>
                <span class="flex items-center gap-2 text-xs font-mono text-zinc-300">
                  <svg class="w-3.5 h-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 7v10M7 12h10"/></svg>
                  Linux <span class="text-white font-semibold">{stats.byOs.Linux}</span>
                </span>
              </div>
            </div>

            <a href="/writeups" class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-white/10 hover:border-accent/40 bg-white/5 hover:bg-accent/5 text-xs font-mono text-zinc-300 hover:text-accent transition-all">
              Browse all writeups
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

          </div>
        </div>

      </div>
    </section>

    {/* ============ FEATURED WORK ============ */}
    <section class="py-16 border-t border-white/5">
      <div class="flex items-end justify-between gap-4 mb-8" data-reveal>
        <div>
          <h2 class="section-title">Featured work</h2>
          <p class="section-subtitle">The projects worth your time.</p>
        </div>
        <a href="/projects" class="link-arrow shrink-0">All {stats.projects} projects</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {featuredProjects.map((project, i) => (
          <a
            href={`/projects/${project.slug}`}
            class="card rounded-2xl p-6 group flex flex-col"
            data-reveal
            data-reveal-delay={i % 2}
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="text-lg font-bold text-white group-hover:text-accent transition-colors">
                {project.title}
              </h3>
              {project.award && (
                <span class="shrink-0 text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-1 rounded-full bg-accent/10 text-accent border border-accent/20">
                  Winner
                </span>
              )}
              {!project.award && project.badge && (
                <span class="shrink-0 text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-1 rounded-full bg-sky-400/10 text-sky-400 border border-sky-400/20">
                  FYP
                </span>
              )}
            </div>
            <p class="text-sm text-zinc-400 leading-relaxed grow">{project.summary}</p>
            {project.tech.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-5">
                {project.tech.slice(0, 5).map(tech => (
                  <span class="text-[10px] font-mono px-2 py-1 rounded-md bg-white/5 border border-white/5 text-zinc-400">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </section>

    {/* ============ LATEST WRITEUPS ============ */}
    <section class="py-16 border-t border-white/5">
      <div class="flex items-end justify-between gap-4 mb-8" data-reveal>
        <div>
          <h2 class="section-title">Latest writeups</h2>
          <p class="section-subtitle">Full kill chains — recon through post-exploitation.</p>
        </div>
        <a href="/writeups" class="link-arrow shrink-0">All {stats.writeups} writeups</a>
      </div>

      <ul class="divide-y divide-white/5 border-y border-white/5">
        {latestWriteups.map((writeup, i) => (
          <li data-reveal data-reveal-delay={i}>
            <a href={`/writeups/${writeup.slug}`} class="group flex items-center gap-4 py-4 px-2 -mx-2 rounded-lg hover:bg-white/[0.03] transition-colors">
              <span class="font-mono text-xs text-zinc-600 w-6 shrink-0 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-semibold text-zinc-100 group-hover:text-accent transition-colors grow truncate">
                {writeup.title}
              </span>
              {writeup.difficulty && (
                <span class={`hidden sm:inline shrink-0 text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded ${
                  writeup.difficulty === 'Easy' ? 'text-accent bg-accent/10' :
                  writeup.difficulty === 'Medium' ? 'text-amber-400 bg-amber-400/10' :
                  writeup.difficulty === 'Hard' ? 'text-rose-500 bg-rose-500/10' :
                  'text-violet-400 bg-violet-400/10'
                }`}>
                  {writeup.difficulty}
                </span>
              )}
              <span class="hidden md:inline shrink-0 font-mono text-xs text-zinc-600 w-24 text-right">
                {writeup.dateDisplay}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

  </div>
</Layout>
