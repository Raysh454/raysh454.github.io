---
import Layout from '../../layouts/Layout.astro';

const modules = import.meta.glob('../../../content/projects/*.md', { eager: true });

function slugFor(fm) {
  return fm.slug ?? String(fm.title || '')
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '');
}

export async function getStaticPaths() {
  const m = import.meta.glob('../../../content/projects/*.md', { eager: true });
  return Object.values(m)
    .map(mod => {
      const fm = mod.frontmatter ?? {};
      const slug = fm.slug ?? String(fm.title || '')
        .toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^a-z0-9-]/g, '');
      return { params: { slug } };
    })
    .filter(entry => entry.params.slug);
}

const { slug } = Astro.params;

let matched = null;
for (const mod of Object.values(modules)) {
  const fm = mod.frontmatter ?? {};
  if (slugFor(fm) === slug) { matched = { mod, fm }; break; }
}

const Project = matched?.mod?.default;
const fm = matched?.fm ?? {};
const tech = Array.isArray(fm.tech) ? fm.tech : [];
---

<Layout title={fm.title} description={fm.summary}>
  {Project ? (
    <article class="max-w-4xl mx-auto px-4 py-6">

      {/* Breadcrumb */}
      <div class="flex items-center gap-2 text-xs font-mono text-zinc-500 mb-4 uppercase tracking-widest">
        <a href="/projects" class="hover:text-accent transition-colors">Projects</a>
        <span class="text-zinc-700">/</span>
        <span class="text-zinc-400 normal-case tracking-normal">{fm.title}</span>
      </div>

      {/* Title header */}
      <header class="mb-8 border-b border-white/5 pb-8">
        {fm.award && (
          <div class="award-banner inline-flex items-center gap-2 px-3 py-1.5 rounded-full mb-4">
            <span aria-hidden="true">🏆</span>
            <span class="text-xs font-semibold text-white">{fm.award}</span>
          </div>
        )}
        {!fm.award && fm.badge && (
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full mb-4 bg-sky-400/10 border border-sky-400/25">
            <span aria-hidden="true">🎓</span>
            <span class="text-xs font-semibold text-sky-300">{fm.badge}</span>
          </div>
        )}

        <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
          {fm.title}
        </h1>

        {fm.summary && (
          <p class="mt-4 text-base md:text-lg text-zinc-400 leading-relaxed max-w-2xl">
            {fm.summary}
          </p>
        )}

        {tech.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-6">
            {tech.map(item => (
              <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-white/5 border border-white/5 text-zinc-400">
                {item}
              </span>
            ))}
          </div>
        )}

        <div class="flex flex-wrap items-center gap-4 mt-6">
          {fm.repo && (
            <a
              href={fm.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary !py-2 !px-4 !text-xs"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              View source
            </a>
          )}
          {fm.date && (
            <span class="font-mono text-xs text-zinc-600">{fm.date}</span>
          )}
        </div>
      </header>

      {/* Markdown body */}
      <div class="obsidian-content">
        <Project />
      </div>

      <div class="mt-16 pt-8 border-t border-white/5">
        <a href="/projects" class="link-arrow">Back to all projects</a>
      </div>

    </article>
  ) : (
    <div class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-xl font-semibold">Not found</h2>
      <p class="muted">The requested project could not be found.</p>
    </div>
  )}
</Layout>
