---
import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../utils/content.js';

const projects = getProjects();
const featured = projects.filter(p => p.featured);
const others = projects.filter(p => !p.featured);
---

<Layout title="Projects" description="Security tooling, systems programming, full-stack applications and a game engine project.">
  <div class="max-w-6xl mx-auto px-4 py-8">

    <header class="mb-12" data-reveal>
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">Projects</h1>
      <div class="w-16 h-1 bg-accent rounded-full mt-3 mb-5"></div>
      <p class="text-zinc-400 max-w-2xl leading-relaxed">
        Security tooling, systems programming, full-stack applications, and a game built around
        an adversarial AI agent. Everything here is open source.
      </p>
    </header>

    {featured.length > 0 && (
      <section class="mb-16">
        <h2 class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-5" data-reveal>
          Featured
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {featured.map((project, i) => (
            <a
              href={`/projects/${project.slug}`}
              class="card rounded-2xl p-6 group flex flex-col"
              data-reveal
              data-reveal-delay={i % 2}
            >
              {project.award && (
                <span class="inline-flex items-center gap-1.5 self-start text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-accent/10 text-accent border border-accent/20 mb-3">
                  🏆 {project.award}
                </span>
              )}
              {!project.award && project.badge && (
                <span class="inline-flex items-center gap-1.5 self-start text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-sky-400/10 text-sky-400 border border-sky-400/20 mb-3">
                  🎓 {project.badge}
                </span>
              )}
              <h3 class="text-xl font-bold text-white group-hover:text-accent transition-colors leading-snug">
                {project.title}
              </h3>
              <p class="mt-2.5 text-sm text-zinc-400 leading-relaxed grow">{project.summary}</p>
              {project.tech.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-5">
                  {project.tech.map(tech => (
                    <span class="text-[10px] font-mono px-2 py-1 rounded-md bg-white/5 border border-white/5 text-zinc-400 group-hover:border-accent/20 transition-colors">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    {others.length > 0 && (
      <section>
        <h2 class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-5" data-reveal>
          More work
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {others.map((project, i) => (
            <a
              href={`/projects/${project.slug}`}
              class="card rounded-xl p-5 group flex flex-col"
              data-reveal
              data-reveal-delay={i % 3}
            >
              <h3 class="font-bold text-white group-hover:text-accent transition-colors">
                {project.title}
              </h3>
              <p class="mt-2 text-xs text-zinc-500 leading-relaxed grow line-clamp-3">
                {project.summary}
              </p>
              {project.tech.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {project.tech.slice(0, 3).map(tech => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-zinc-500">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
